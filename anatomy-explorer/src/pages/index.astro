---
/**
 * Home — the three first-class entry points of A-014.
 *
 * Rebuilt on `Base.astro` and `tokens.css`. The previous shell rendered its own
 * bare `<html>` with `global.css`, so it carried none of the safety chrome: no
 * persistent disclaimer, no text-size control, no footer disclosures, no skip
 * link. Those are launch dependencies (D-004), not decoration.
 *
 * The counts are real. "Find my area" is the primary route, but a patient who
 * already knows what they were given should not have to go through a body map
 * to reach it, which is why all three entrances sit at the same level.
 */
import Base from '../layouts/Base.astro';
import { getPublishedAreas } from '../lib/library';
import { getAreaChoices } from '../data/anatomy/body-regions';
import { SECTION_COPY, sectionPath } from '../lib/section';

const [stretching, exercise, areaChoices] = await Promise.all([
  getPublishedAreas('stretching'),
  getPublishedAreas('exercise'),
  getAreaChoices(),
]);

const sections = [
  { key: 'stretching' as const, areas: stretching },
  { key: 'exercise' as const, areas: exercise },
];
---

<Base
  title="Home Exercise Library"
  description="The stretches and exercises your physiotherapist prescribed, organised by body area."
>
  <div class="hero">
    <p class="crumb">Physiotherapy</p>
    <h1>Home Exercise Library</h1>
    <p class="lede">
      The stretches and exercises your physiotherapist went through with you.
      Start with the body area they pointed to.
    </p>
  </div>

  <div class="choices entrances">
    <a href="/find-my-area/" class="choice">
      <span class="choice-head">
        <span class="choice-title">Find my body area</span>
        <span class="choice-count">
          {areaChoices.length} {areaChoices.length === 1 ? 'area' : 'areas'}
        </span>
      </span>
      <span class="choice-desc">Pick from a body map or a plain list.</span>
    </a>
    {sections.map(({ key, areas }) => (
      <a href={sectionPath(key)} class="choice">
        <span class="choice-head">
          <span class="choice-title">{SECTION_COPY[key].title}</span>
          <span class="choice-count">
            {areas.length} {areas.length === 1 ? 'area' : 'areas'}
          </span>
        </span>
        <span class="choice-desc">{SECTION_COPY[key].lede}</span>
        {areas.length > 0 && (
          <span class="choice-areas">{areas.map((a) => a.name_en).join(' · ')}</span>
        )}
      </a>
    ))}
  </div>

  <div class="guide">
    <h2>How to use this library</h2>
    <ol>
      <li><span class="dot">1</span><span><b>Find your area</b> — the body part your physiotherapist pointed to.</span></li>
      <li><span class="dot">2</span><span><b>Follow the dosage</b> — the holds, repetitions and sets shown on each card.</span></li>
      <li><span class="dot">3</span><span><b>Stop if it hurts</b> — sharp pain, dizziness or numbness means stop and contact the clinic.</span></li>
    </ol>
  </div>
</Base>

<style>
.hero { padding: 26px 0 4px; }
.crumb {
  font-family: var(--f-display); font-weight: 600;
  font-size: calc(11px * var(--scale)); letter-spacing: .14em;
  text-transform: uppercase; color: var(--ink-3); margin: 0 0 8px;
}
.hero h1 {
  font-family: var(--f-display); font-weight: 700;
  font-size: calc(clamp(28px, 7.5vw, 40px) * var(--scale));
  line-height: 1.08; letter-spacing: -.02em; margin: 0 0 10px; text-wrap: balance;
}
.lede { margin: 0; color: var(--ink-2); max-width: 56ch; font-size: calc(17px * var(--scale)); }

/* sections */
.choices { display: grid; gap: 12px; margin-top: 26px; }
@media (min-width: 720px) { .entrances { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.choice {
  display: grid; gap: 7px; align-content: start;
  text-decoration: none; color: inherit;
  background: var(--surface); border: 1px solid var(--line); border-radius: var(--r, 14px);
  padding: 20px 22px; min-height: 120px;
  transition: border-color .12s ease;
}
.choice:hover { border-color: var(--line-2); }
.choice:focus-visible { outline: 3px solid var(--brand); outline-offset: 2px; }
.choice-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; min-width: 0; }
.choice-title {
  font-family: var(--f-display); font-weight: 700;
  font-size: calc(21px * var(--scale)); letter-spacing: -.01em;
}
.choice-count {
  font-family: var(--f-mono); font-size: calc(12px * var(--scale));
  color: var(--ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; flex: none;
}
.choice-desc { color: var(--ink-2); font-size: calc(15.5px * var(--scale)); line-height: 1.45; }
.choice-areas {
  color: var(--ink-3); font-size: calc(13px * var(--scale)); line-height: 1.5;
  padding-top: 6px; border-top: 1px solid var(--line);
}

/* guidance */
.guide {
  margin: 26px 0 0; background: var(--surface); border: 1px solid var(--line);
  border-radius: var(--r, 14px); padding: 18px 20px;
}
.guide h2 {
  font-family: var(--f-display); font-weight: 600;
  font-size: calc(11.5px * var(--scale)); letter-spacing: .14em;
  text-transform: uppercase; color: var(--ink-3); margin: 0 0 12px;
}
.guide ol { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
.guide li {
  display: grid; grid-template-columns: auto 1fr; gap: 11px; align-items: start;
  font-size: calc(15.5px * var(--scale)); color: var(--ink-2);
}
.guide li b { color: var(--ink); font-weight: 600; }
.dot {
  width: 19px; height: 19px; border-radius: 6px; margin-top: 3px;
  background: var(--strengthen-bg); color: var(--strengthen);
  display: grid; place-items: center;
  font-size: calc(11px * var(--scale)); font-weight: 700;
}

@media (prefers-reduced-motion: reduce) {
  .choice { transition: none; }
}
</style>
