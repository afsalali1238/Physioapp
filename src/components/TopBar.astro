---
---
<div class="top">
  <div class="top-in">
    <p class="brandmark"><span>Physiotherapy</span>Patient Library</p>
    <button class="tbtn" id="textSizeBtn" aria-label="Toggle text size">Text Size</button>
  </div>
</div>

<style>
.top {
  position: sticky;
  top: 0;
  z-index: 40;
  background: var(--brand);
  color: var(--brand-ink);
}
.top-in {
  max-width: 780px;
  margin: 0 auto;
  padding: 11px var(--pad);
  display: flex;
  align-items: center;
  gap: 10px;
}
.brandmark {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: calc(15px * var(--scale));
  margin: 0;
  flex: 1;
  min-width: 0;
  line-height: 1.2;
}
.brandmark span {
  display: block;
  font-weight: 500;
  font-size: calc(10.5px * var(--scale));
  letter-spacing: .15em;
  text-transform: uppercase;
  opacity: .7;
}
.tbtn {
  font-family: var(--f-display);
  font-weight: 600;
  font-size: calc(13px * var(--scale));
  background: transparent;
  color: inherit;
  border: 1px solid currentColor;
  border-radius: 999px;
  padding: 5px 12px;
  cursor: pointer;
  opacity: .8;
  white-space: nowrap;
  min-height: 34px;
}
.tbtn:hover { opacity: 1; }
.tbtn:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; opacity: 1; }
</style>

<script>
  const btn = document.getElementById('textSizeBtn');
  const sizes = ['1', '1.15', '1.3'];
  let currentSizeIdx = 0;
  
  btn?.addEventListener('click', () => {
    currentSizeIdx = (currentSizeIdx + 1) % sizes.length;
    document.documentElement.style.setProperty('--scale', sizes[currentSizeIdx]);
  });
</script>
