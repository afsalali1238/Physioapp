---
/**
 * Base layout — MODULES.md M06.
 *
 * Two deliberate changes from the earlier version:
 *
 * 1. `<ClientRouter />` was removed. It ships a client-side router and animates
 *    page transitions, against PRD §10 ("JS shipped: near zero on content
 *    pages") and DESIGN-SYSTEM's "Motion: almost none · no page transitions".
 *    Patients open two or three pages on a phone that may be old and on a slow
 *    connection; a router costs more than it saves.
 *
 * 2. The skip link is now the first element in the body. It previously sat after
 *    the disclaimer and the top bar, so a keyboard or switch user had to tab
 *    through a dismiss button and the text-size control before reaching the link
 *    whose entire job is to come first.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import TopBar from '../components/TopBar.astro';
import Disclaimer from '../components/Disclaimer.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  description = 'Home exercise and stretching instructions from your physiotherapist.',
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {Astro.url.pathname.startsWith('/preview') && <meta name="robots" content="noindex, nofollow" />}
    {!Astro.url.pathname.startsWith('/preview') && <meta name="robots" content="index, follow" />}
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0ea5e9" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Disclaimer />
    <TopBar />
    <main id="main-content" class="wrap">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -60px;
    inset-inline-start: 0;
    z-index: 100;
    background: var(--ink);
    color: var(--ground);
    padding: 12px 18px;
    min-height: 44px;
    display: flex;
    align-items: center;
    text-decoration: none;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(var(--fs-small) * var(--scale));
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: 0;
  }

  .wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--pad) 24px;
  }
</style>
