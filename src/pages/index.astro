---
import Base from '../layouts/Base.astro';
---

<Base title="Home Exercise Library">
  <div class="hero">
    <p class="crumb">Physiotherapy</p>
    <h1>Home Exercise Library</h1>
    <p>Select a section to view your prescribed exercises or stretches.</p>
  </div>
  
  <div class="choices">
    <a href="/stretching" class="choice">
      <div>
        <svg class="ic" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="20" cy="7" r="3.4"/><path d="M20 10.6v11M20 21.6 13.5 33M20 21.6 26.5 33M8.5 15.5 20 13.2l11.5 2.3"/></svg>
        <h2>Stretching</h2>
        <p>Relieve tension and improve flexibility.</p>
      </div>
    </a>
    <a href="/exercise" class="choice">
      <div>
        <svg class="ic" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 20h4M30 20h4M12 13v14M28 13v14M12 20h16"/><path d="M9 16.5v7M31 16.5v7"/></svg>
        <h2>Exercises</h2>
        <p>Build strength, control, and mobility.</p>
      </div>
    </a>
  </div>
  
  <div class="guide">
    <h3>How to use this library</h3>
    <ul>
      <li><div class="dot">1</div><span><b>Find your area</b> — Navigate to the specific body part your physiotherapist indicated.</span></li>
      <li><div class="dot">2</div><span><b>Follow the dosage</b> — Perform exactly the holds or repetitions listed.</span></li>
      <li><div class="dot">3</div><span><b>Prioritise safety</b> — Stop immediately if you feel sharp pain or dizziness.</span></li>
    </ul>
  </div>
</Base>

<style>
/* hero */
.hero { padding: 26px 0 4px; }
.hero h1 {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: calc(clamp(28px, 7.5vw, 40px) * var(--scale));
  line-height: 1.08;
  letter-spacing: -.02em;
  margin: 0 0 10px;
  text-wrap: balance;
}
.hero p { margin: 0; color: var(--ink-2); max-width: 56ch; font-size: calc(17px * var(--scale)); }
.crumb {
  font-family: var(--f-display);
  font-weight: 600;
  font-size: calc(11px * var(--scale));
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin: 0 0 8px;
}

/* choices */
.choices { display: grid; gap: 12px; margin-top: 24px; }
@media(min-width: 600px) { .choices { grid-template-columns: 1fr 1fr; } }
.choice {
  display: flex; flex-direction: column; justify-content: space-between; gap: 14px;
  text-decoration: none; color: inherit;
  background: var(--surface); border: 1px solid var(--line); border-radius: var(--r, 14px);
  padding: 24px 22px; min-height: 150px;
  transition: border-color .12s ease, transform .12s ease;
}
.choice:hover { border-color: var(--line-2); transform: translateY(-2px); }
.choice:focus-visible { outline: 3px solid var(--brand); outline-offset: 2px; }
.choice .ic { width: 38px; height: 38px; color: var(--ink-3); margin-bottom: 12px; }
.choice h2 { font-family: var(--f-display); font-weight: 700; font-size: calc(23px * var(--scale)); margin: 0 0 5px; letter-spacing: -.01em; }
.choice p { margin: 0; color: var(--ink-2); font-size: calc(15.5px * var(--scale)); line-height: 1.45; }

/* guidance */
.guide { margin: 26px 0 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r, 14px); padding: 18px 20px; }
.guide h3 { font-family: var(--f-display); font-weight: 600; font-size: calc(11.5px * var(--scale)); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); margin: 0 0 12px; }
.guide ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
.guide li { display: grid; grid-template-columns: auto 1fr; gap: 11px; align-items: start; font-size: calc(15.5px * var(--scale)); color: var(--ink-2); }
.guide li b { color: var(--ink); font-weight: 600; }
.dot { width: 19px; height: 19px; border-radius: 6px; margin-top: 3px; background: var(--strengthen-bg); color: var(--strengthen); display: grid; place-items: center; font-size: calc(11px * var(--scale)); font-weight: 700; }
</style>
